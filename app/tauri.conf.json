{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Death Recap",
  "version": "0.3.3",
  "identifier": "com.flavbest.death-recap",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "font-src": "'self' https://assets.playnccdn.com",
        "img-src": "'self' data: https://assets.playnccdn.com https://profileimg.plaync.com",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
